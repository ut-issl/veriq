    "FileRef": {
      "description": "Reference to a local file.\n\nStreams file for checksum - doesn't load entire file into memory.\nUser accesses data via `path` attribute.\n\nRelative paths are resolved against the base directory set via\n`input_base_dir()` context manager (typically the TOML file's directory).\n\nExample:\n    # In model definition\n    class MyModel(BaseModel):\n        config_file: FileRef\n\n    # In calculation\n    @scope.calculation()\n    def process(config_file: Annotated[FileRef, vq.Ref(\"$.config_file\")]) -> Result:\n        data = config_file.path.read_bytes()\n        return process_data(data)\n\n    # In TOML\n    [Scope.model.config_file]\n    path = \"data/config.json\"\n    checksum = \"sha256:abc123...\"  # Added by veriq after first run",
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileRef",
      "type": "object"
    },
